# Contact form delivery
# Keep demo mode enabled to validate submissions without sending email.
GMAIL_DEMO_MODE=true

# The fallback is chowdorydevops@gmail.com; set this only to use another recipient.
# GMAIL_CONTACT_TO=chowdorydevops@gmail.com

# Set the values below and change GMAIL_DEMO_MODE to false to enable Gmail SMTP delivery.
# GMAIL_SMTP_USER=your-gmail-address@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
